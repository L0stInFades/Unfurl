<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>
    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <TitleBar x:Name="WindowTitleBar" Title="Unfurl" IsPaneToggleButtonVisible="True" Background="Transparent" />
  <NavigationView Grid.Row="1" x:Name="WorkspaceNavigation" PaneDisplayMode="Auto" OpenPaneLength="176"
                CompactPaneLength="48" ExpandedModeThresholdWidth="860" CompactModeThresholdWidth="500"
                IsBackButtonVisible="Collapsed" IsSettingsVisible="True" AlwaysShowHeader="False"
                IsPaneToggleButtonVisible="False" IsTitleBarAutoPaddingEnabled="False"
                Background="Transparent">
  <NavigationView.MenuItems>
    <NavigationViewItem x:Name="CompressNavigation" Content="压缩" Icon="Save" />
    <NavigationViewItem x:Name="ExtractNavigation" Content="解压" Icon="Download" />
  </NavigationView.MenuItems>
  <Grid>
  <Grid x:Name="Workspace" Padding="24,20,24,16" RowSpacing="16" UseLayoutRounding="True" MaxWidth="844" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock x:Name="WorkspaceHeading" Text="创建压缩包" FontFamily="Microsoft YaHei UI" FontSize="26" FontWeight="SemiBold" />
    <ScrollViewer Grid.Row="1" x:Name="WorkspaceScroll" AutomationProperties.AutomationId="WorkspaceScroll"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
      <StackPanel x:Name="BodyGrid" Spacing="18" Padding="0,0,8,4">
        <StackPanel x:Name="SourcesPanel" Spacing="6">
          <Grid ColumnSpacing="12" MinHeight="36">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock x:Name="ItemsHeading" Text="待压缩项目" FontWeight="SemiBold" />
              <TextBlock x:Name="SelectionTitle" Text="0 项" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button x:Name="ReadArchiveCommand" Width="32" Height="32" Padding="0" Visibility="Collapsed" AutomationProperties.Name="重新读取压缩包" ToolTipService.ToolTip="重新读取压缩包">
                <FontIcon Glyph="&#xE72C;" FontSize="16" />
              </Button>
              <Button x:Name="OpenArchiveCommand" Height="32" Visibility="Collapsed" ToolTipService.ToolTip="打开压缩包">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8E5;" FontSize="16" /><TextBlock Text="打开压缩包" /></StackPanel>
              </Button>
              <Button x:Name="AddFilesCommand" Height="32" ToolTipService.ToolTip="添加文件">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="16" /><TextBlock Text="添加文件" /></StackPanel>
              </Button>
              <Button x:Name="AddFolderCommand" Width="32" Height="32" Padding="0" AutomationProperties.Name="添加文件夹" ToolTipService.ToolTip="添加文件夹">
                <FontIcon Glyph="&#xE8B7;" FontSize="16" />
              </Button>
              <Button x:Name="ClearCommand" Width="32" Height="32" Padding="0" IsEnabled="False" AutomationProperties.Name="清空列表" ToolTipService.ToolTip="清空列表">
                <FontIcon Glyph="&#xE74D;" FontSize="16" />
              </Button>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="SelectionDetail" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <Border x:Name="DropZone" MinHeight="104" CornerRadius="6" AllowDrop="True" BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
              <StackPanel x:Name="EmptySelection" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                <FontIcon x:Name="EmptySelectionIcon" Glyph="&#xE8B7;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="EmptySelectionText" Text="尚未选择文件或文件夹" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <StackPanel x:Name="ItemsPanel" Visibility="Collapsed">
                <Grid x:Name="ListHeader" Padding="12,4" MinHeight="32" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                  <CheckBox x:Name="SelectAllItems" MinWidth="0" MinHeight="24" Width="24" Padding="0" Visibility="Collapsed" AutomationProperties.Name="全选" ToolTipService.ToolTip="全选" />
                  <TextBlock Grid.Column="1" Text="名称" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock Grid.Column="2" Text="大小" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListView x:Name="FileList" Height="40" SelectionMode="None" IsMultiSelectCheckBoxEnabled="True" Padding="0,4" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="项目列表">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnSpacing="12" ToolTipService.ToolTip="{Binding [Name]}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="{Binding [Glyph]}" FontSize="16" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="{Binding [Name]}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding [Size]}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                  <ListView.ItemContainerStyle>
                    <!-- Keep WinUI's checkbox fills, theme states, and keyboard focus visuals. -->
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="12,4" />
                    </Style>
                  </ListView.ItemContainerStyle>
                </ListView>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
        <StackPanel x:Name="SettingsPanel" Spacing="8">
          <TextBlock x:Name="SettingsHeading" Text="输出设置" FontWeight="SemiBold" Margin="0,0,0,4" />
          <Grid x:Name="NameFormatGrid" Padding="14,12" ColumnSpacing="12" RowSpacing="10" CornerRadius="4" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <FontIcon Glyph="&#xE8A5;" FontSize="18" VerticalAlignment="Center" />
            <TextBlock x:Name="ArchiveNameLabel" Grid.Column="1" Text="压缩包名称" VerticalAlignment="Center" />
            <TextBox x:Name="ArchiveNameBox" Grid.Column="2" PlaceholderText="压缩包" MaxLength="120" AutomationProperties.Name="压缩包名称" />
            <ComboBox x:Name="FormatComboBox" Grid.Column="3" HorizontalAlignment="Stretch" SelectedIndex="0" AutomationProperties.Name="压缩格式" ToolTipService.ToolTip="压缩格式">
              <x:String>ZIP</x:String><x:String>7Z</x:String><x:String>TAR.GZ</x:String>
              <x:String>TAR.BZ2</x:String><x:String>TAR.XZ</x:String><x:String>TAR.ZST</x:String>
            </ComboBox>
          </Grid>
          <Button x:Name="DestinationCommand" Padding="14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="选择保存位置" ToolTipService.ToolTip="选择保存位置">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center" />
              <TextBlock x:Name="DestinationLabel" Grid.Column="1" Text="保存位置" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="DestinationBox" Text="源文件所在文件夹" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DestinationPath" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Expander x:Name="ArchiveOptions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
            <Expander.Header>
              <StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE713;" FontSize="18" /><TextBlock Text="更多选项" FontSize="14" VerticalAlignment="Center" /></StackPanel>
            </Expander.Header>
            <StackPanel x:Name="PasswordSplitGrid" Spacing="12">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="144" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="密码" VerticalAlignment="Center" />
                <PasswordBox x:Name="ArchivePasswordBox" Grid.Column="1" PlaceholderText="留空则不加密" MaxLength="1024" AutomationProperties.Name="密码" />
              </Grid>
              <Grid x:Name="SplitRow" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="144" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="分卷大小（MiB）" VerticalAlignment="Center" />
                <TextBox x:Name="SplitSizeBox" Grid.Column="1" PlaceholderText="不分卷" MaxLength="10" AutomationProperties.Name="分卷大小（MiB）" />
              </Grid>
            </StackPanel>
          </Expander>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" RowSpacing="12" Padding="0,0,8,0">
      <Grid.RowDefinitions><RowDefinition Height="2" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Height="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
      <ProgressBar x:Name="OperationProgress" Height="2" Opacity="0" IsIndeterminate="False" />
      <Grid Grid.Row="1" ColumnSpacing="12" MinHeight="36">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Button x:Name="RevealCommand" Grid.Column="1" Width="36" Height="36" Padding="0" Visibility="Collapsed" AutomationProperties.Name="打开输出位置" ToolTipService.ToolTip="在文件资源管理器中显示结果">
          <FontIcon Glyph="&#xE8B7;" FontSize="16" />
        </Button>
        <Button x:Name="CancelCommand" Grid.Column="2" Height="36" Visibility="Collapsed" MinWidth="116" Content="取消" />
        <Button x:Name="ExtractCommand" Grid.Column="2" Height="36" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" MinWidth="116" IsEnabled="False">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;" FontSize="16" /><TextBlock Text="解压" /></StackPanel>
        </Button>
        <Button x:Name="CompressCommand" Grid.Column="2" Height="36" Style="{StaticResource AccentButtonStyle}" MinWidth="116" IsEnabled="False">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="16" /><TextBlock Text="压缩" /></StackPanel>
        </Button>
      </Grid>
    </Grid>
  </Grid>
  <Grid x:Name="AppSettingsPage" Visibility="Collapsed" Padding="24,20,32,16" RowSpacing="24" MaxWidth="844" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TextBlock x:Name="AppSettingsHeading" Text="设置" FontFamily="Microsoft YaHei UI" FontSize="26" FontWeight="SemiBold" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="8">
        <TextBlock Text="外观" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Grid Padding="16,14" ColumnSpacing="16" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="164" /></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="颜色模式" VerticalAlignment="Center" TextWrapping="Wrap" />
          <ComboBox x:Name="ThemeChoice" Grid.Column="2" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="颜色模式">
            <x:String>使用系统设置</x:String><x:String>浅色</x:String><x:String>深色</x:String>
          </ComboBox>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  </Grid>
  </NavigationView>
</Grid>

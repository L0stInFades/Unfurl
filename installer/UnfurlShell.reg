[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Unfurl.Compress\command]
@="\"C:\\Program Files\\Unfurl\\Unfurl.exe\" --compress \"%1\""

[HKEY_CURRENT_USER\Software\Classes\*\shell\Unfurl.Compress]

Windows Registry Editor Version 5.00

; Per-user Explorer integration for unpackaged builds.
; Replace the path below with the installed Unfurl.exe location.

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.zip\shell\Unfurl.Extract]
@="Extract with Unfurl"
"Icon"="C:\\Program Files\\Unfurl\\Unfurl.exe,0"
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.zip\shell\Unfurl.Extract\command]
@="\"C:\\Program Files\\Unfurl\\Unfurl.exe\" \"%1\""


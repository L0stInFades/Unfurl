Windows Registry Editor Version 5.00

; Per-user Explorer integration for unpackaged development builds.
; Replace the path below with the installed Unfurl.exe location.
[HKEY_CURRENT_USER\Software\Classes\*\shell\Unfurl.Extract]
@="Extract with Unfurl"
"Icon"="C:\\Program Files\\Unfurl\\Unfurl.exe"

[HKEY_CURRENT_USER\Software\Classes\*\shell\Unfurl.Extract\command]
@="\"C:\\Program Files\\Unfurl\\Unfurl.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Unfurl.Compress]
@="Compress with Unfurl"
"Icon"="C:\\Program Files\\Unfurl\\Unfurl.exe"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Unfurl.Compress\command]
@="\"C:\\Program Files\\Unfurl\\Unfurl.exe\" \"%1\""

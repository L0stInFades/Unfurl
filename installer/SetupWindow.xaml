<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent" UseLayoutRounding="True">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TitleBar x:Name="SetupTitleBar" Title="Unfurl 安装" Background="Transparent"/>
  <Grid Grid.Row="1" Padding="32,20,32,28" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="6">
      <TextBlock Text="安装 Unfurl" Style="{StaticResource TitleTextBlockStyle}"/>
      <TextBlock Text="轻巧的 Windows 压缩工具" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <Border Grid.Row="1" Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="一次准备，后续自动更新" FontWeight="SemiBold"/>
        <TextBlock Text="将准备 Unfurl 安装证书和微软运行组件。Windows 可能请求管理员确认，随后由你确认安装。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">
        <ProgressBar x:Name="SetupProgress" Visibility="Collapsed" IsIndeterminate="False"/>
        <TextBlock x:Name="SetupStatus" AutomationProperties.AutomationId="SetupStatus" AutomationProperties.LiveSetting="Polite" Text="准备就绪" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelSetup" AutomationProperties.AutomationId="CancelSetup" Content="取消" MinWidth="96"/>
      <Button x:Name="ContinueSetup" AutomationProperties.AutomationId="ContinueSetup" Content="准备并继续" MinWidth="132" Style="{StaticResource AccentButtonStyle}"/>
    </StackPanel>
  </Grid>
</Grid>
